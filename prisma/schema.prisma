generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// משתמשים
model User {
  id              String           @id @default(cuid())
  name            String
  email           String?          @unique
  password        String?          // bcrypt hash
  role            String           @default("user") // admin, user
  status          String           @default("approved") // pending, approved
  totpSecret      String?          // 2FA - TOTP secret (מוצפן)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdRecords  DynamicRecord[] @relation("createdBy")
  assignedRecords DynamicRecord[] @relation("assignedTo")
  tasks           RecordTask[]
  callLogs        CallLog[]
  backups         Backup[]
  activities      DynamicActivity[]
  notes           RecordNote[]
  notifications   Notification[]
}

// התראות למשתמש (הקצאה, משימה וכו')
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // assignment, task_due, task_assigned, mention
  title     String
  body      String?
  link      String?  // /dynamic/leads/xxx
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

// טוקן לאיפוס סיסמה
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// תגיות גלובליות - אדמין מגדיר
model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")  // hex
  createdAt DateTime @default(now())
  records   RecordTag[]
}

// ישות דינמית - אדמין מגדיר
model Entity {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fields      FieldDefinition[]
  records     DynamicRecord[]
  templates   RecordTemplate[]
}

// הגדרת שדה
model FieldDefinition {
  id          String   @id @default(cuid())
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name        String
  label       String
  type        String   // text, number, email, phone, textarea, select, multiselect, date, datetime, checkbox, file, url, currency, user, relation
  options     String?  // JSON
  required    Boolean  @default(false)
  order       Int      @default(0)
  section     String?
  showInList  Boolean  @default(true)   // מופיע בראשי הטבלה
  showInCard  Boolean  @default(true)   // מופיע בכרטסת בלחיצה
  placeholder String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  files       RecordFile[]
  @@unique([entityId, name])
}

// רשומה דינמית
model DynamicRecord {
  id            String     @id @default(cuid())
  entityId      String
  entity        Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  data          Json
  isArchived    Boolean    @default(false)  // ארכוב - לא נמחק, רק מוסתר
  createdById   String?
  createdBy     User?      @relation("createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId  String?    // משתמש אחראי
  assignedTo    User?      @relation("assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  activities    DynamicActivity[]
  files         RecordFile[]
  tasks         RecordTask[]
  callLogs      CallLog[]
  notes         RecordNote[]
  tags          RecordTag[]
}

// קישור רשומה-תגית
model RecordTag {
  id        String         @id @default(cuid())
  recordId  String
  record    DynamicRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  @@unique([recordId, tagId])
}

// תבניות רשומה - יצירה מהירה
model RecordTemplate {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name      String
  data      Json     // נתוני ברירת מחדל
  createdAt DateTime @default(now())
}

// משימות לרשומה
model RecordTask {
  id          String         @id @default(cuid())
  recordId    String
  record      DynamicRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean        @default(false)
  dueDate     DateTime?      // תאריך יעד להתראה
  order       Int            @default(0)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
}

// לוג שיחות - לחיבור למערכת טלפונית (API)
model CallLog {
  id          String         @id @default(cuid())
  recordId    String?
  record      DynamicRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  phoneNumber String
  direction   String         // incoming, outgoing
  duration    Int?           // שניות
  notes       String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  @@index([phoneNumber])
}

// קבצים מצורפים
model RecordFile {
  id                String   @id @default(cuid())
  recordId          String
  record            DynamicRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fieldDefinitionId String?
  fieldDefinition   FieldDefinition? @relation(fields: [fieldDefinitionId], references: [id], onDelete: SetNull)
  filename          String
  url               String
  size              Int?
  createdAt         DateTime @default(now())
}

// פעילות לרשומות
model DynamicActivity {
  id          String         @id @default(cuid())
  recordId    String
  record      DynamicRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type        String         // created, updated, task_added, task_done, call_added, note_added
  content     String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
}

// הערות לרשומות
model RecordNote {
  id          String         @id @default(cuid())
  recordId    String
  record      DynamicRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  content     String
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
}

// תצוגות שמורות
model SavedView {
  id       String  @id @default(cuid())
  name     String
  filter   String? // JSON של פילטרים
  sort     String? // JSON: { field, dir }
  module   String  // entitySlug
  userId   String? // תצוגה אישית
}

// גיבויים - רק אדמין רואה ומשחזר
model Backup {
  id          String   @id @default(cuid())
  data        Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// אינטגרציות - חיבור למערכות חיצוניות (Twilio, SendGrid, וכו')
model Integration {
  id          String   @id @default(cuid())
  type        String   // twilio, sendgrid, webhook, zapier, slack, etc.
  name        String
  isActive    Boolean  @default(true)
  credentials Json     // מוצפן - API keys, tokens
  config      Json     @default("{}") // הגדרות נוספות (מספר טלפון, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        IntegrationLog[]
}

// לוג קריאות לאינטגרציות
model IntegrationLog {
  id             String      @id @default(cuid())
  integrationId  String
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  action         String      // send_sms, send_email, webhook_call, etc.
  status         String      // success, error
  details        Json?       // תגובה, שגיאה
  createdAt      DateTime    @default(now())
  @@index([integrationId, createdAt])
}

// Webhooks - שליחת אירועים ל-URL חיצוני
model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  secret      String?  // להחתמת payload (HMAC)
  events      String   // JSON: ["record.created", "record.updated", ...]
  isActive    Boolean  @default(true)
  entitySlug  String?  // null = כל הישויות
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Audit Log - מעקב פעולות חשובות
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String   // record.create, record.update, record.delete, user.login, etc.
  entitySlug String?
  recordId   String?
  details    Json?    // שינויים, meta
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// API Keys - גישה חיצונית ל-API
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   // hash של המפתח (לא המפתח עצמו)
  keyPrefix   String   // 4 תווים ראשונים להצגה
  permissions String   // JSON: ["records:read", "records:write", ...]
  lastUsedAt  DateTime?
  expiresAt  DateTime?
  createdAt   DateTime @default(now())
  @@unique([keyPrefix])
}

// אוטומציות – כללים (כששדה X משתנה ל-Y – צור משימה / webhook)
model WorkflowRule {
  id           String   @id @default(cuid())
  name         String
  entitySlug   String
  trigger      String   // record.created, record.updated
  condition    String?  // JSON: { field, op, value } או null = תמיד
  action       String   // create_task, call_webhook
  actionConfig String?  // JSON: { taskTitle?, webhookUrl? }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
